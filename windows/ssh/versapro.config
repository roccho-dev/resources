# VersaPro native-only management entry, applied by windows ClientSsh
# (-ClientConfig this file -ClientKnownHosts windows/ssh/versapro.known_hosts) as the owned
# ~/.ssh/windows-client/{config,known_hosts} slot. Do not paste it into ~/.ssh/config. No secret is declared here.

# The physical VersaPro NixOS root management channel. 192.168.0.103 is only a LAN locator; the pinned
# host key below is the identity.
Host versapro-ssd
  HostName 192.168.0.103
  User root
  Port 22
  HostKeyAlias versapro-ssd-1804BQ0831CWM370
  IdentityFile ~/.ssh/id_ed25519_windows_own
  IdentitiesOnly yes
  StrictHostKeyChecking yes
  UserKnownHostsFile ~/.ssh/windows-client/known_hosts
  UpdateHostKeys no
  BatchMode yes
